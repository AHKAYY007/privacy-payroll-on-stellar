# Stellar testnet RPC
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract IDs (deploy on testnet first)
TOKEN_CONTRACT_ID=C...
CONFIDENTIAL_CONTRACT_ID=C...

# Supplier account (must be registered on the configured token).
SUPPLIER_NAME=Emeka Supplies
SUPPLIER_ADDRESS=
# Optional: set only if the backend will register/decrypt for this supplier.
SUPPLIER_SECRET=

# Grumpkin scalar whose public key is registered for this auditor id.
AUDITOR_GRUMPKIN_SECRET_HEX=
AUDITOR_ID=0

# Ledger where CONFIDENTIAL_CONTRACT_ID was deployed; used for initial sync.
TOKEN_DEPLOYED_AT_LEDGER=5371973
