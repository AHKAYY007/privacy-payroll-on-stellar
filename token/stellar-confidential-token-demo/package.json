{
  "name": "confidential-token-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confidential token demo on Stellar (Soroban) — contracts, deploy/e2e scripts, web app and indexer, on stellar-confidential-token-sdk.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ctd/app dev",
    "build:contracts": "bash scripts/build-contracts.sh",
    "deploy:contracts": "tsx scripts/deploy.ts",
    "deploy:app": "pnpm --filter @ctd/app run deploy:cf",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:disclosure": "tsx scripts/e2e-disclosure.ts",
    "e2e:advanced": "tsx scripts/e2e-advanced.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@stellar/stellar-sdk": "^14.2.0",
    "stellar-confidential-token-sdk": "github:brozorec/stellar-confidential-token-sdk#aad1706",
    "tsx": "^4.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "stellar-confidential-token-sdk",
      "workerd"
    ]
  }
}
